<section>
    <h2>Spisok tranzakcii</h2>

    <table>
        <tr>
            <th>id</th>
            <th>date</th>
            <th>amount</th>
            <th>description</th>
            <th>merchant</th>
            <th>days</th>
        </tr>

        {% for transaction in transactions %}
            <tr>
                <td>{{ transaction.id }}</td>
                <td>{{ transaction.date }}</td>
                <td>{{ transaction.amount|number_format(2) }}</td>
                <td>{{ transaction.description }}</td>
                <td>{{ transaction.merchant }}</td>
                <td>{{ transaction.days }}</td>
            </tr>
        {% endfor %}
        <tr>
            <th colspan="6">Total Amount: {{ totalAmount|number_format(2) }}</th>
        </tr>
    </table>
</section>

<section>
    <h2>findTransactionByDescription: Kupili</h2>

    <table>
        <tr>
            <th>id</th>
            <th>description</th>
        </tr>

        {% for transaction in foundTransactions %}
            <tr>
                <td>{{ transaction.id }}</td>
                <td>{{ transaction.description }}</td>
            </tr>
        {% endfor %}
    </table>
</section>

<section>
    <h2>findTransactionById primer: 4</h2>
    {% if transactionById is not null %}
        <p>
            Tranzakciya s id 4:
            {{ transactionById.description }},
            stoimost {{ transactionById.amount|number_format(2) }}
        </p>
    {% endif %}
</section>

